diff --git a/arch/ps4/bits/alltypes.h.in b/arch/ps4/bits/alltypes.h.in
index 2e4b49cc..a70371fd 100644
--- a/arch/ps4/bits/alltypes.h.in
+++ b/arch/ps4/bits/alltypes.h.in
@@ -26,3 +26,11 @@ TYPEDEF unsigned int blksize_t;
 TYPEDEF struct __sigset_t { unsigned int __bits[4]; } sigset_t;
 
 TYPEDEF struct { long long __ll; long double __ld; } max_align_t;
+
+/* PS4: pthreads come from Sony's libkernel (FreeBSD ABI), where these are
+   pointer-sized or larger. musl's 4-byte defaults get overrun by libkernel. */
+TYPEDEF struct { void *__attr; } pthread_mutexattr_t;
+TYPEDEF struct { void *__attr; } pthread_condattr_t;
+TYPEDEF struct { void *__attr; } pthread_barrierattr_t;
+TYPEDEF long pthread_spinlock_t;
+TYPEDEF struct { int __state; void *__mutex; } pthread_once_t;
